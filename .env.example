# MailPilot AI Server Configuration

# Port to run the Express backend on
PORT=5000

# Google Gemini API Key (Required for live AI email classification, summaries & drafting)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Optional for prototype)
# If left unset or unreachable, the server automatically uses an in-memory fallback store
# Note: In-memory store data is temporary and resets when the server restarts
MONGODB_URI=mongodb://localhost:27017/mailpilot_ai
